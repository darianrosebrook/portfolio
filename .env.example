# Supabase (https://supabase.com/dashboard/project/_/settings/api-keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the new publishable key (sb_publishable_...). Legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Prefer the new secret key (sb_secret_...). Never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated Supabase auth user IDs for privileged admin APIs (e.g. image cleanup)
ADMIN_USER_IDS=

# Optional site origin overrides (auth redirect allowlist)
# NEXT_PUBLIC_SITE_URL=https://darianrosebrook.com

# --- Private package registries -------------------------------------------
# `pnpm install` fails with ERR_PNPM_FETCH_401 until these are configured.
#
# These two do NOT belong in this file or in the project .npmrc — pnpm 11
# ignores _authToken lines in a committed .npmrc and refuses to expand
# ${VARS} in them. Put them in your USER-level ~/.npmrc, where expansion
# does work:
#
#   //npm.fontawesome.com/:_authToken=${FONTAWESOME_PACKAGE_TOKEN}
#   //registry.tiptap.dev/:_authToken=${TIPTAP_PRO_PACKAGE_TOKEN}
#
# ...with the values exported in your shell. Or set them literally:
#
#   pnpm config set "//npm.fontawesome.com/:_authToken" <token>
#   pnpm config set "//registry.tiptap.dev/:_authToken" <token>
#
# Font Awesome Pro kit token: https://fontawesome.com/account/general
# Tiptap Pro registry token:  https://cloud.tiptap.dev/pro-extensions
