{
  "permissions": {
    "allow": [
      "Bash(caws --version*)",
      "Bash(caws --help*)",
      "Bash(caws help*)",
      "Bash(caws status*)",
      "Bash(caws doctor*)",
      "Bash(caws scope *)",
      "Bash(caws specs*)",
      "Bash(caws worktree *)",
      "Bash(caws claim*)",
      "Bash(caws gates*)",
      "Bash(caws evidence *)",
      "Bash(caws prepush*)",
      "Bash(caws agents *)",
      "Bash(caws message *)",
      "Bash(caws waiver *)",
      "Bash(caws events list*)",
      "Bash(caws events show *)",
      "Bash(caws events verify-archive*)",
      "Bash(caws events --help*)",
      "Bash(caws reprieve show*)",
      "Bash(caws reprieve list*)",
      "Bash(caws reprieve --help*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-frontmatter-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
