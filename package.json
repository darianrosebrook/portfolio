{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "build": "npm run tokens:build:full && next build",
    "build:full": "npm run tokens:build:full && npm run typecheck && npm run lint && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:css": "stylelint --allow-empty-input \"**/*.{css,scss}\"",
    "lint:fix:css": "stylelint --fix \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node ./node_modules/typescript-7/lib/tsc.js --noEmit",
    "validate": "npm run contracts:validate && npm run contracts:traceability && npm run contracts:tokens && npm run tokens:lint && npm run styles:tokens && npm run typecheck && npm run lint && npm run format:check",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "contracts:check": "node scripts/validate-contracts.mjs",
    "contracts:traceability": "node scripts/check-contract-traceability.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "analyze": "ANALYZE=true npm run build",
    "tokens:build": "tsx utils/designTokens/runners/build.ts && node utils/designTokens/generators/generateCSSTokens.mjs",
    "tokens:build:full": "tsx utils/designTokens/runners/build.ts --no-incremental && node utils/designTokens/generators/generateCSSTokens.mjs",
    "tokens:compose": "tsx utils/designTokens/generators/compose.ts",
    "tokens:global": "tsx utils/designTokens/generators/global.ts",
    "tokens:types": "tsx utils/designTokens/generators/types.ts",
    "tokens:components": "node utils/designTokens/generators/generateCSSTokens.mjs",
    "tokens:schema": "node utils/designTokens/generators/generateSchema.mjs",
    "tokens:validate": "node utils/designTokens/validators/validateTokens.mjs",
    "tokens:inspect": "node utils/designTokens/validators/inspectTokens.mjs",
    "tokens:usage": "tsx utils/designTokens/runners/usage.ts",
    "tokens:usage:json": "tsx utils/designTokens/runners/usage.ts --json",
    "tokens:lint": "node scripts/check-kebab-token-vars.mjs && node scripts/check-token-references.mjs",
    "styles:tokens": "node scripts/check-style-token-values.mjs",
    "validate:components": "node scripts/validateComponents.mjs",
    "validate:component-visibility": "node scripts/validateComponentVisibility.mjs",
    "scaffold:component": "node scripts/scaffoldComponent.mjs",
    "generate:components-docs": "node scripts/generateComponentsAndDocs.mjs",
    "generate:contracts": "node scripts/generateContracts.mjs",
    "contracts:tokens": "node scripts/check-contract-tokens.mjs",
    "components:setup": "npm run generate:contracts && npm run contracts:validate && npm run validate:components",
    "components:health": "node scripts/componentHealthCheck.mjs",
    "setup:hooks": "bash scripts/setup-hooks.sh",
    "hook:audit": "bash scripts/audit-hook-bypasses.sh",
    "perf:budgets": "lhci autorun --config=.lighthouserc.js",
    "perf:budgets:mobile": "lhci autorun --config=lighthouserc.mobile.js",
    "perf:audit": "lhci autorun --config=.lighthouserc.js --collect.url=http://localhost:3000",
    "perf:audit:all": "npm run build && npm run start & sleep 10 && npm run perf:budgets && pkill -f 'next start'",
    "perf:compare": "lhci autorun --config=.lighthouserc.js --collect.numberOfRuns=1"
  },
  "dependencies": {
    "@atproto/api": "^0.20.44",
    "@awesome.me/kit-0ba7f5fefb": "^1.0.49",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@gsap/react": "^2.1.2",
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-drag-handle": "3.31.3",
    "@tiptap/extension-dropcursor": "^3.31.3",
    "@tiptap/extension-focus": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-node-range": "3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "@types/hls.js": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "bezier-js": "^6.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "fontkit": "^2.0.4",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "hls.js": "^1.7.3",
    "kld-intersections": "^0.7.0",
    "lowlight": "^3.3.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg-intersections": "^0.4.0",
    "yjs": "13.6.32",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svg-intersections": "^0.4.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.6",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
